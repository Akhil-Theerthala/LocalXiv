{
  "manifest_version": 3,
  "name": "Papers to Kindle",
  "version": "0.2.0",
  "description": "Send arXiv and alphaXiv papers or alphaXiv library folders to Kindle.",
  "permissions": ["activeTab", "storage", "nativeMessaging", "scripting"],
  "host_permissions": ["https://export.arxiv.org/*"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Send papers to Kindle",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  }
}
