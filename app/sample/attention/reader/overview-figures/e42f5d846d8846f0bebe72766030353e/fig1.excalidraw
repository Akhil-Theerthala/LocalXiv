      "isDeleted": false,
      "boundElements": null,
      "updated": 1709640000000,
      "link": null,
      "locked": false,
      "text": "Divides scores by sqrt(d_k)\nto prevent vanishing \ngradients, masking invalid \npositions to -inf.",
      "fontSize": 20,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "top"
    },
