    },
    {
      "id": "heading0",
      "type": "text",
      "x": 44,
      "y": 44,
      "width": 364,
      "height": 84,
      "angle": 0,
      "strokeColor": "#3d5130",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a255v",
      "roundness": null,
      "seed": 100004,
      "version": 1,
      "versionNonce": 100005,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1709640000000,
      "link": null,
      "locked": false,
      "text": "Why discard \nrecurrent layers?",
      "fontSize": 30,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "id": "body0",
      "type": "text",
      "x": 44,
      "y": 146,
      "width": 364,
      "height": 268.79999999999995,
      "angle": 0,
      "strokeColor": "#292d23",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a255y",
      "roundness": null,
      "seed": 100007,
      "version": 1,
      "versionNonce": 100008,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1709640000000,
      "link": null,
      "locked": false,
      "text": "Recurrence computes \nhidden states \nsequentially, blocking \nparallel training across\npositions; convolutions \nrequire multi-layer \npaths to connect distant\ntokens.",
      "fontSize": 24,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "id": "panel1",
      "type": "rectangle",
      "x": 16,
      "y": 458.79999999999995,
      "width": 420,
      "height": 426.79999999999995,
      "angle": 0,
      "strokeColor": "transparent",
      "backgroundColor": "#f3f1eb",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a2561",
      "roundness": {
        "type": 3
      },
      "seed": 100010,
      "version": 1,
      "versionNonce": 100011,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1709640000000,
      "link": null,
      "locked": false
    },
    {
      "id": "heading1",
      "type": "text",
      "x": 44,
      "y": 486.79999999999995,
      "width": 364,
      "height": 84,
      "angle": 0,
      "strokeColor": "#3d5130",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a2564",
      "roundness": null,
      "seed": 100013,
      "version": 1,
      "versionNonce": 100014,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1709640000000,
      "link": null,
      "locked": false,
      "text": "How does scaled \ndot-product work?",
      "fontSize": 30,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "id": "body1",
      "type": "text",
      "x": 44,
      "y": 588.8,
      "width": 364,
      "height": 268.79999999999995,
      "angle": 0,
      "strokeColor": "#292d23",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a2567",
      "roundness": null,
      "seed": 100016,
      "version": 1,
      "versionNonce": 100017,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1709640000000,
      "link": null,
      "locked": false,
      "text": "It computes query-key \ndot products scaled by \n1/sqrt(d_k) before \nsoftmax to prevent \nvanishing gradients at \nlarge dimensions, \nproducing value weights \nin O(1) operations.",
      "fontSize": 24,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "id": "panel2",
      "type": "rectangle",
      "x": 16,
      "y": 901.5999999999999,
      "width": 420,
      "height": 460.4,
      "angle": 0,
      "strokeColor": "transparent",
      "backgroundColor": "#d6dfc7",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a256a",
      "roundness": {
        "type": 3
      },
      "seed": 100019,
      "version": 1,
      "versionNonce": 100020,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1709640000000,
      "link": null,
      "locked": false
    },
    {
      "id": "heading2",
      "type": "text",
      "x": 44,
      "y": 929.5999999999999,
      "width": 364,
      "height": 84,
      "angle": 0,
      "strokeColor": "#3d5130",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a256d",
      "roundness": null,
      "seed": 100022,
      "version": 1,
      "versionNonce": 100023,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1709640000000,
      "link": null,
      "locked": false,
      "text": "Why split into \nmultiple heads?",
      "fontSize": 30,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "id": "body2",
      "type": "text",
      "x": 44,
      "y": 1031.6,
      "width": 364,
      "height": 302.4,
      "angle": 0,
      "strokeColor": "#292d23",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a256g",
      "roundness": null,
      "seed": 100025,
      "version": 1,
      "versionNonce": 100026,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1709640000000,
      "link": null,
      "locked": false,
      "text": "Projecting queries, \nkeys, and values into 8 \nparallel heads (d_k=64) \nallows joint attention \nacross distinct \nrepresentation \nsubspaces, overcoming \nsingle-head averaging \nloss.",
      "fontSize": 24,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "id": "panel3",
      "type": "rectangle",
      "x": 16,
      "y": 1378,
      "width": 420,
      "height": 468.79999999999995,
      "angle": 0,
      "strokeColor": "transparent",
      "backgroundColor": "#e5e8dd",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a256j",
      "roundness": {
        "type": 3
      },
      "seed": 100028,
      "version": 1,
      "versionNonce": 100029,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1709640000000,
      "link": null,
      "locked": false
    },
    {
      "id": "heading3",
      "type": "text",
      "x": 44,
      "y": 1406,
      "width": 364,
      "height": 125.99999999999999,
      "angle": 0,
      "strokeColor": "#3d5130",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a256m",
      "roundness": null,
      "seed": 100031,
      "version": 1,
      "versionNonce": 100032,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1709640000000,
      "link": null,
      "locked": false,
      "text": "How is order \ntracked without \nrecurrence?",
      "fontSize": 30,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "id": "body3",
      "type": "text",
      "x": 44,
      "y": 1550,
      "width": 364,
      "height": 268.79999999999995,
      "angle": 0,
      "strokeColor": "#292d23",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a256p",
      "roundness": null,
      "seed": 100034,
      "version": 1,
      "versionNonce": 100035,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1709640000000,
      "link": null,
      "locked": false,
      "text": "Fixed sinusoidal \npositional encodings of \ndimension d_model are \nadded to embeddings, \nletting the model attend\nby relative positions \nthrough linear \ntransformations.",
      "fontSize": 24,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "id": "panel4",
      "type": "rectangle",
      "x": 16,
      "y": 1862.8,
      "width": 420,
      "height": 502.4,
      "angle": 0,
      "strokeColor": "transparent",
      "backgroundColor": "#f3f1eb",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a256s",
      "roundness": {
        "type": 3
      },
      "seed": 100037,
      "version": 1,
      "versionNonce": 100038,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1709640000000,
      "link": null,
      "locked": false
    },
    {
      "id": "heading4",
      "type": "text",
      "x": 44,
      "y": 1890.8,
      "width": 364,
      "height": 125.99999999999999,
      "angle": 0,
      "strokeColor": "#3d5130",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a256v",
      "roundness": null,
      "seed": 100040,
      "version": 1,
      "versionNonce": 100041,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1709640000000,
      "link": null,
      "locked": false,
      "text": "How is the full \nnetwork \nconstructed?",
      "fontSize": 30,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "id": "body4",
      "type": "text",
      "x": 44,
      "y": 2034.8,
      "width": 364,
      "height": 302.4,
      "angle": 0,
      "strokeColor": "#292d23",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a256y",
      "roundness": null,
      "seed": 100043,
      "version": 1,
      "versionNonce": 100044,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1709640000000,
      "link": null,
      "locked": false,
      "text": "Six stacked encoder and \ndecoder layers use \nresidual connections, \nlayer normalization, \npoint-wise feed-forward \nblocks, and masked \nself-attention to \npreserve \nauto-regression.",
      "fontSize": 24,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "id": "panel5",
      "type": "rectangle",
      "x": 16,
      "y": 2381.2,
      "width": 420,
      "height": 435.2,
      "angle": 0,
      "strokeColor": "transparent",
      "backgroundColor": "#f3f1eb",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a2571",
      "roundness": {
        "type": 3
      },
      "seed": 100046,
      "version": 1,
      "versionNonce": 100047,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1709640000000,
      "link": null,
      "locked": false
    },
    {
      "id": "heading5",
      "type": "text",
      "x": 44,
      "y": 2409.2,
      "width": 364,
      "height": 125.99999999999999,
      "angle": 0,
      "strokeColor": "#3d5130",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a2574",
      "roundness": null,
      "seed": 100049,
      "version": 1,
      "versionNonce": 100050,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1709640000000,
      "link": null,
      "locked": false,
      "text": "What translation \nperformance was \nachieved?",
      "fontSize": 30,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "id": "body5",
      "type": "text",
      "x": 44,
      "y": 2553.2,
      "width": 364,
      "height": 235.2,
      "angle": 0,
      "strokeColor": "#292d23",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a2577",
      "roundness": null,
      "seed": 100052,
      "version": 1,
      "versionNonce": 100053,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1709640000000,
      "link": null,
      "locked": false,
      "text": "The Transformer reached \n28.4 BLEU on WMT 2014 \nEnglish-German and 41.8 \nBLEU on English-French, \noutperforming prior \nensembles while training\non 8 GPUs for 3.5 days.",
      "fontSize": 24,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "id": "panel6",
      "type": "rectangle",
      "x": 16,
      "y": 2832.3999999999996,
      "width": 420,
      "height": 460.4,
      "angle": 0,
      "strokeColor": "transparent",
      "backgroundColor": "#e5e8dd",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a257a",
      "roundness": {
        "type": 3
      },
      "seed": 100055,
      "version": 1,
      "versionNonce": 100056,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1709640000000,
      "link": null,
      "locked": false
    },
    {
      "id": "heading6",
      "type": "text",
      "x": 44,
      "y": 2860.3999999999996,
      "width": 364,
      "height": 84,
      "angle": 0,
      "strokeColor": "#3d5130",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a257d",
      "roundness": null,
      "seed": 100058,
      "version": 1,
      "versionNonce": 100059,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1709640000000,
      "link": null,
      "locked": false,
      "text": "What limitations \nremain?",
      "fontSize": 30,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "id": "body6",
      "type": "text",
      "x": 44,
      "y": 2962.3999999999996,
      "width": 364,
      "height": 302.4,
      "angle": 0,
      "strokeColor": "#292d23",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a257g",
      "roundness": null,
      "seed": 100061,
      "version": 1,
      "versionNonce": 100062,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1709640000000,
      "link": null,
      "locked": false,
      "text": "Decoder inference \nremains \nauto-regressively \nsequential, and \nattention complexity \nscales quadratically \n(O(n^2*d)) with sequence\nlength, challenging \nlarger contexts.",
      "fontSize": 24,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top"
    }
  ],
  "appState": {
    "viewBackgroundColor": "#ffffff",
