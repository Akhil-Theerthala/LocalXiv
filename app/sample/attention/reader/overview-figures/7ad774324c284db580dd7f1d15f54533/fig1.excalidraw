      "locked": false
    },
    {
      "id": "heading0",
      "type": "text",
      "x": 44,
      "y": 44,
      "width": 477.4573643410853,
      "height": 84,
      "angle": 0,
      "strokeColor": "#3d5130",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a255v",
      "roundness": null,
      "seed": 100004,
      "version": 1,
      "versionNonce": 100005,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1709640000000,
      "link": null,
      "locked": false,
      "text": "Why discard recurrent \nlayers?",
      "fontSize": 30,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "id": "body0",
      "type": "text",
      "x": 44,
      "y": 146,
      "width": 477.4573643410853,
      "height": 201.6,
      "angle": 0,
      "strokeColor": "#292d23",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a255y",
      "roundness": null,
      "seed": 100007,
      "version": 1,
      "versionNonce": 100008,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1709640000000,
      "link": null,
      "locked": false,
      "text": "Recurrence computes hidden \nstates sequentially, blocking \nparallel training across \npositions; convolutions require\nmulti-layer paths to connect \ndistant tokens.",
      "fontSize": 24,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "id": "panel1",
      "type": "rectangle",
      "x": 565.4573643410853,
      "y": 16,
      "width": 570.5426356589147,
      "height": 359.6,
      "angle": 0,
      "strokeColor": "transparent",
      "backgroundColor": "#f3f1eb",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a2561",
      "roundness": {
        "type": 3
      },
      "seed": 100010,
      "version": 1,
      "versionNonce": 100011,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1709640000000,
      "link": null,
      "locked": false
    },
    {
      "id": "heading1",
      "type": "text",
      "x": 593.4573643410853,
      "y": 44,
      "width": 514.5426356589147,
      "height": 84,
      "angle": 0,
      "strokeColor": "#3d5130",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a2564",
      "roundness": null,
      "seed": 100013,
      "version": 1,
      "versionNonce": 100014,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1709640000000,
      "link": null,
      "locked": false,
      "text": "How does scaled dot-product\nwork?",
      "fontSize": 30,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "id": "body1",
      "type": "text",
      "x": 593.4573643410853,
      "y": 146,
      "width": 514.5426356589147,
      "height": 201.6,
      "angle": 0,
      "strokeColor": "#292d23",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a2567",
      "roundness": null,
      "seed": 100016,
      "version": 1,
      "versionNonce": 100017,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1709640000000,
      "link": null,
      "locked": false,
      "text": "It computes query-key dot products\nscaled by 1/sqrt(d_k) before \nsoftmax to prevent vanishing \ngradients at large dimensions, \nproducing value weights in O(1) \noperations.",
      "fontSize": 24,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "id": "panel2",
      "type": "rectangle",
      "x": 16,
      "y": 391.6,
      "width": 432.9632892804699,
      "height": 645.2,
      "angle": 0,
      "strokeColor": "transparent",
      "backgroundColor": "#d6dfc7",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a256a",
      "roundness": {
        "type": 3
      },
      "seed": 100019,
      "version": 1,
      "versionNonce": 100020,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1709640000000,
      "link": null,
      "locked": false
    },
    {
      "id": "heading2",
      "type": "text",
      "x": 44,
      "y": 419.6,
      "width": 376.9632892804699,
      "height": 84,
      "angle": 0,
      "strokeColor": "#3d5130",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a256d",
      "roundness": null,
      "seed": 100022,
      "version": 1,
      "versionNonce": 100023,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1709640000000,
      "link": null,
      "locked": false,
      "text": "Why split into \nmultiple heads?",
      "fontSize": 30,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "id": "body2",
      "type": "text",
      "x": 44,
      "y": 521.6,
      "width": 376.9632892804699,
      "height": 268.79999999999995,
      "angle": 0,
      "strokeColor": "#292d23",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a256g",
      "roundness": null,
      "seed": 100025,
      "version": 1,
      "versionNonce": 100026,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1709640000000,
      "link": null,
      "locked": false,
      "text": "Projecting queries, keys,\nand values into 8 \nparallel heads (d_k=64) \nallows joint attention \nacross distinct \nrepresentation subspaces,\novercoming single-head \naveraging loss.",
      "fontSize": 24,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "id": "panel3",
      "type": "rectangle",
      "x": 464.9632892804699,
      "y": 391.6,
      "width": 322.72540381791487,
      "height": 645.2,
      "angle": 0,
      "strokeColor": "transparent",
      "backgroundColor": "#e5e8dd",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a256j",
      "roundness": {
        "type": 3
      },
      "seed": 100028,
      "version": 1,
      "versionNonce": 100029,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1709640000000,
      "link": null,
      "locked": false
    },
    {
      "id": "heading3",
      "type": "text",
      "x": 492.9632892804699,
      "y": 419.6,
      "width": 266.72540381791487,
      "height": 168,
      "angle": 0,
      "strokeColor": "#3d5130",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a256m",
      "roundness": null,
      "seed": 100031,
      "version": 1,
      "versionNonce": 100032,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1709640000000,
      "link": null,
      "locked": false,
      "text": "How is order \ntracked \nwithout \nrecurrence?",
      "fontSize": 30,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "id": "body3",
      "type": "text",
      "x": 492.9632892804699,
      "y": 605.6,
      "width": 266.72540381791487,
      "height": 403.2,
      "angle": 0,
      "strokeColor": "#292d23",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a256p",
      "roundness": null,
      "seed": 100034,
      "version": 1,
      "versionNonce": 100035,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1709640000000,
      "link": null,
      "locked": false,
      "text": "Fixed sinusoidal \npositional \nencodings of \ndimension d_model\nare added to \nembeddings, \nletting the model\nattend by \nrelative \npositions through\nlinear \ntransformations.",
      "fontSize": 24,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "id": "panel4",
      "type": "rectangle",
      "x": 803.6886930983848,
      "y": 391.6,
      "width": 332.31130690161524,
      "height": 645.2,
      "angle": 0,
      "strokeColor": "transparent",
      "backgroundColor": "#f3f1eb",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a256s",
      "roundness": {
        "type": 3
      },
      "seed": 100037,
      "version": 1,
      "versionNonce": 100038,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1709640000000,
      "link": null,
      "locked": false
    },
    {
      "id": "heading4",
      "type": "text",
      "x": 831.6886930983848,
      "y": 419.6,
      "width": 276.31130690161524,
      "height": 125.99999999999999,
      "angle": 0,
      "strokeColor": "#3d5130",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a256v",
      "roundness": null,
      "seed": 100040,
      "version": 1,
      "versionNonce": 100041,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1709640000000,
      "link": null,
      "locked": false,
      "text": "How is the \nfull network \nconstructed?",
      "fontSize": 30,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "id": "body4",
      "type": "text",
      "x": 831.6886930983848,
      "y": 563.6,
      "width": 276.31130690161524,
      "height": 403.2,
      "angle": 0,
      "strokeColor": "#292d23",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a256y",
      "roundness": null,
      "seed": 100043,
      "version": 1,
      "versionNonce": 100044,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1709640000000,
      "link": null,
      "locked": false,
      "text": "Six stacked \nencoder and \ndecoder layers use\nresidual \nconnections, layer\nnormalization, \npoint-wise \nfeed-forward \nblocks, and masked\nself-attention to \npreserve \nauto-regression.",
      "fontSize": 24,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "id": "panel5",
      "type": "rectangle",
      "x": 16,
      "y": 1052.8000000000002,
      "width": 575.9999999999999,
      "height": 359.6,
      "angle": 0,
      "strokeColor": "transparent",
      "backgroundColor": "#f3f1eb",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a2571",
      "roundness": {
        "type": 3
      },
      "seed": 100046,
      "version": 1,
      "versionNonce": 100047,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1709640000000,
      "link": null,
      "locked": false
    },
    {
      "id": "heading5",
      "type": "text",
      "x": 44,
      "y": 1080.8000000000002,
      "width": 519.9999999999999,
      "height": 84,
      "angle": 0,
      "strokeColor": "#3d5130",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a2574",
      "roundness": null,
      "seed": 100049,
      "version": 1,
      "versionNonce": 100050,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1709640000000,
      "link": null,
      "locked": false,
      "text": "What translation \nperformance was achieved?",
      "fontSize": 30,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "id": "body5",
      "type": "text",
      "x": 44,
      "y": 1182.8000000000002,
      "width": 519.9999999999999,
      "height": 201.6,
      "angle": 0,
      "strokeColor": "#292d23",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a2577",
      "roundness": null,
      "seed": 100052,
      "version": 1,
      "versionNonce": 100053,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1709640000000,
      "link": null,
      "locked": false,
      "text": "The Transformer reached 28.4 BLEU \non WMT 2014 English-German and \n41.8 BLEU on English-French, \noutperforming prior ensembles \nwhile training on 8 GPUs for 3.5 \ndays.",
      "fontSize": 24,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "id": "panel6",
      "type": "rectangle",
      "x": 607.9999999999999,
      "y": 1052.8000000000002,
      "width": 528,
      "height": 359.6,
      "angle": 0,
      "strokeColor": "transparent",
      "backgroundColor": "#e5e8dd",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a257a",
      "roundness": {
        "type": 3
      },
      "seed": 100055,
      "version": 1,
      "versionNonce": 100056,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1709640000000,
      "link": null,
      "locked": false
    },
    {
      "id": "heading6",
      "type": "text",
      "x": 635.9999999999999,
      "y": 1080.8000000000002,
      "width": 472,
      "height": 42,
      "angle": 0,
      "strokeColor": "#3d5130",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a257d",
      "roundness": null,
      "seed": 100058,
      "version": 1,
      "versionNonce": 100059,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1709640000000,
      "link": null,
      "locked": false,
      "text": "What limitations remain?",
      "fontSize": 30,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "id": "body6",
      "type": "text",
      "x": 635.9999999999999,
      "y": 1140.8000000000002,
      "width": 472,
      "height": 201.6,
      "angle": 0,
      "strokeColor": "#292d23",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a257g",
      "roundness": null,
      "seed": 100061,
      "version": 1,
      "versionNonce": 100062,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1709640000000,
      "link": null,
      "locked": false,
      "text": "Decoder inference remains \nauto-regressively sequential, \nand attention complexity scales\nquadratically (O(n^2*d)) with \nsequence length, challenging \nlarger contexts.",
      "fontSize": 24,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top"
    }
  ],
